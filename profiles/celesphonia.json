        "B": {
          "enabled": true,
          "strength": 40,
          "wave": "pulse",
          "seconds": 1.5
        }
      },
      "cooldownMs": 5000
    },
    {
      "id": "battle_sys_boss",
      "trigger": {
        "source": "expression",
        "value": "tickerId === 'EncountBoss' || tickerId === 'ScenceBoss'"
