{
  "name": "Celesphonia",
  "game": "魔法少女苍蓝星 / Magical Girl Celesphonia",
  "engine": "RPG Maker MV 1.6.1",
  "gameDir": "",
  "output": {
    "mode": "device"
  },
  "notes": [
    "触发条件为 trigger（source/op/value 或 expression），输出为 outputs.A/B。",
    "每个规则可同时启用 A/B：各自波形、强度 0-200、秒数（0=持续到条件结束）。",
    "波形：const 持续 / sine 呼吸 / tide 潮汐 / heart 心跳 / pulse 脉冲 / rampUp 渐强 / rampDown 渐弱 / saw 锯齿 / random 随机 / massage 按摩。",
    "设备输出为负鼠官方协议 B3+B0；不再经过 DGPro。"
  ],
  "vars": {
    "lust": 1021,
    "lustMax": 1034,
    "extasy": 1026,
    "estrus": 1027,
    "erosion": 1022,
    "miasma": 1030,
    "miasmaMax": 1037,
    "domination": 212,
    "clothDur": 741,
    "clothDurMax": 742
  },
  "switches": {
    "swimming": 267,
    "poolOpen": 261,
    "poolHasHazuki": 268,
    "swimsuit": 883,
    "competitionSwimsuit": 886,
    "inBattle": 18
  },
  "rules": [
    {
      "id": "battle_climax",
      "trigger": {
        "source": "expression",
        "value": "(/^(AttackEstrus|DamagePinchL3|GaspingL3)/.test(tickerId)) || /要去了|去了……|绝顶|高潮/.test(ticker)"
      },
      "outputs": {
        "A": {
          "enabled": true,
          "strength": 70,
          "wave": "const",
          "seconds": 3
        },
        "B": {
          "enabled": false
        }
      },
      "cooldownMs": 8000
    },
    {
      "id": "battle_act_l3",
      "trigger": {
        "source": "expression",
        "value": "/L3/.test(tickerId) && /^(Nipple|NippleLick|BoobsKnead|clitoris|Kiss)/.test(tickerId)"
      },
      "outputs": {
        "A": {
          "enabled": false
        },
        "B": {
          "enabled": true,
          "strength": 55,
          "wave": "sine",
          "seconds": 2
        }
      },
      "cooldownMs": 4000
    },
    {
      "id": "battle_act_l1",
      "trigger": {
        "source": "expression",
        "value": "/L1/.test(tickerId) && /^(Nipple|NippleLick|BoobsKnead|clitoris|Kiss)/.test(tickerId)"
      },
      "outputs": {
        "A": {
          "enabled": false
        },
        "B": {
          "enabled": true,
          "strength": 25,
          "wave": "sine",
          "seconds": 2
        }
      },
      "cooldownMs": 3000
    },
    {
      "id": "battle_resist",
      "trigger": {
        "source": "ticker",
        "op": "regex",
        "value": "不要|讨厌|放开我|やめて"
      },
      "outputs": {
        "A": {
          "enabled": true,
          "strength": 45,
          "wave": "sine",
          "seconds": 2
        },
        "B": {
          "enabled": false
        }
      },
      "cooldownMs": 5000
    },
    {
      "id": "battle_crisis",
      "trigger": {
        "source": "tickerId",
        "op": "prefix",
        "value": "Crisis"
      },
      "outputs": {
        "A": {
          "enabled": true,
          "strength": 60,
          "wave": "const",
          "seconds": 3
        },
        "B": {
          "enabled": false
        }
      },
      "cooldownMs": 8000
    },
    {
      "id": "battle_sys_trap",
      "trigger": {
        "source": "tickerId",
        "op": "equals",
